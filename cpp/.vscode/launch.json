{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C/C++: g++.exe 启动调试",
            "type": "cppdbg",
            "request": "launch",
            // 自动获取当前打开的文件，编译后生成同名exe
            "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            // 弹出单独的控制台窗口，方便看输出
            "externalConsole": true,
            "MIMode": "gdb",
            // 你的gdb路径
            "miDebuggerPath": "C:\\Program Files\\mingw64\\bin\\gdb.exe",
            // 关联编译任务，先编译再调试
            "preLaunchTask": "C/C++: g++.exe 生成活动文件",
            "setupCommands": [
                {
                    "description": "为 gdb 启用整齐打印",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
